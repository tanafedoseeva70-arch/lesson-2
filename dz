import torch
import torch.nn as nn
from torch.utils.data import Dataset, DataLoader
from sklearn.datasets import load_diabetes, load_breast_cancer
from sklearn.model_selection import train_test_split
from sklearn.preprocessing import StandardScaler
import numpy as np
import copy



# 1. Dataset обёртка

class CustomTabularDataset(Dataset):
    """Универсальный Dataset для табличных данных."""
    def __init__(self, X: np.ndarray, y: np.ndarray):
        self.X = torch.tensor(X, dtype=torch.float32)
        # Приводим y к форме (N, 1) для бинарной задачи / регрессии
        self.y = torch.tensor(y, dtype=torch.float32).view(-1, 1)

    def __len__(self):
        return len(self.X)

    def __getitem__(self, idx):
        return self.X[idx], self.y[idx]



# 2. Модели: Линейная и Логистическая

class LinearRegressionModel(nn.Module):
    def __init__(self, in_features: int):
        super().__init__()
        self.linear = nn.Linear(in_features, 1)

    def forward(self, x):
        return self.linear(x)


class LogisticRegressionModel(nn.Module):
    def __init__(self, in_features: int):
        super().__init__()
        self.linear = nn.Linear(in_features, 1)

    def forward(self, x):
        # Возвращаем сырые логиты для численной стабильности (под BCEWithLogitsLoss)
        return self.linear(x)



# 3. Механизм Early Stopping

class EarlyStopping:
    def __init__(self, patience: int = 10, min_delta: float = 1e-4):
        self.patience = patience
        self.min_delta = min_delta
        self.counter = 0
        self.best_loss = float('inf')
        self.best_weights = None
        self.early_stop = False

    def __call__(self, val_loss: float, model: nn.Module):
        if val_loss < self.best_loss - self.min_delta:
            self.best_loss = val_loss
            self.counter = 0
            self.best_weights = copy.deepcopy(model.state_dict())
        else:
            self.counter += 1
            if self.counter >= self.patience:
                self.early_stop = True



# 4. Универсальный Training Loop

def train_model(
    model: nn.Module,
    train_loader: DataLoader,
    val_loader: DataLoader,
    criterion: nn.Module,
    optimizer: torch.optim.Optimizer,
    epochs: int = 100,
    l1_lambda: float = 0.0,
    patience: int = 15
):
    early_stopping = EarlyStopping(patience=patience)

    for epoch in range(1, epochs + 1):
        # Режим обучения
        model.train()
        train_loss = 0.0

        for X_batch, y_batch in train_loader:
            optimizer.zero_grad()
            preds = model(X_batch)
            loss = criterion(preds, y_batch)

            # L1 регуляризация (L2 встроена в оптимизатор через weight_decay)
            if l1_lambda > 0.0:
                l1_penalty = sum(p.abs().sum() for p in model.parameters())
                loss = loss + l1_lambda * l1_penalty

            loss.backward()
            optimizer.step()
            train_loss += loss.item() * len(X_batch)

        train_loss /= len(train_loader.dataset)

        # Режим валидации
        model.eval()
        val_loss = 0.0
        with torch.no_grad():
            for X_batch, y_batch in val_loader:
                preds = model(X_batch)
                batch_loss = criterion(preds, y_batch)
                val_loss += batch_loss.item() * len(X_batch)

        val_loss /= len(val_loader.dataset)

        if epoch % 10 == 0 or epoch == 1:
            print(f"Epoch [{epoch:03d}/{epochs}] | Train Loss: {train_loss:.4f} | Val Loss: {val_loss:.4f}")

        # Проверка Early Stopping
        early_stopping(val_loss, model)
        if early_stopping.early_stop:
            print(f"--> Остановка на эпохе {epoch}. Восстановление лучших весов.")
            model.load_state_dict(early_stopping.best_weights)
            break

    return model



# 5. Пример запуска (на Diabetes и Breast Cancer)

if __name__ == "__main__":
    torch.manual_seed(42)

    # --- ТЕСТ 1: Линейная регрессия (Diabetes) ---
    print("=== 1. Линейная регрессия (Diabetes) ===")
    X_reg, y_reg = load_diabetes(return_X_y=True)
    X_train, X_val, y_train, y_val = train_test_split(X_reg, y_reg, test_size=0.2, random_state=42)

    scaler_reg = StandardScaler()
    X_train = scaler_reg.fit_transform(X_train)
    X_val = scaler_reg.transform(X_val)

    train_loader_reg = DataLoader(CustomTabularDataset(X_train, y_train), batch_size=32, shuffle=True)
    val_loader_reg = DataLoader(CustomTabularDataset(X_val, y_val), batch_size=32, shuffle=False)

    lin_model = LinearRegressionModel(in_features=X_train.shape[1])
    # weight_decay реализует L2-регуляризацию
    optimizer = torch.optim.AdamW(lin_model.parameters(), lr=0.05, weight_decay=1e-3)
    criterion = nn.MSELoss()

    train_model(lin_model, train_loader_reg, val_loader_reg, criterion, optimizer, epochs=80, l1_lambda=0.01)

    # Сохранение весов
    torch.save(lin_model.state_dict(), "linear_model.pth")
    print("Веса сохранены в linear_model.pth\n")

    # --- ТЕСТ 2: Логистическая регрессия (Breast Cancer) ---
    print("=== 2. Логистическая регрессия (Breast Cancer) ===")
    X_clf, y_clf = load_breast_cancer(return_X_y=True)
    X_train, X_val, y_train, y_val = train_test_split(X_clf, y_clf, test_size=0.2, random_state=42)

    scaler_clf = StandardScaler()
    X_train = scaler_clf.fit_transform(X_train)
    X_val = scaler_clf.transform(X_val)

    train_loader_clf = DataLoader(CustomTabularDataset(X_train, y_train), batch_size=32, shuffle=True)
    val_loader_clf = DataLoader(CustomTabularDataset(X_val, y_val), batch_size=32, shuffle=False)

    log_model = LogisticRegressionModel(in_features=X_train.shape[1])
    optimizer = torch.optim.Adam(log_model.parameters(), lr=0.01)
    criterion = nn.BCEWithLogitsLoss()

    train_model(log_model, train_loader_clf, val_loader_clf, criterion, optimizer, epochs=50)

    # Оценка точности (Accuracy)
    log_model.eval()
    with torch.no_grad():
        preds_logits = log_model(torch.tensor(X_val, dtype=torch.float32))
        probs = torch.sigmoid(preds_logits)
        predicted_classes = (probs >= 0.5).int().squeeze()
        acc = (predicted_classes.numpy() == y_val).mean()
        print(f"Validation Accuracy: {acc * 100:.2f}%")
